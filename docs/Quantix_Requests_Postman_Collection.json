								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"External SSD 1TB Drive\",\n    \"description\": \"Need high-speed drive for local caching.\",\n    \"category\": \"hardware\",\n    \"priority\": \"medium\",\n    \"submit_immediately\": false\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/requests",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"requests"
							]
