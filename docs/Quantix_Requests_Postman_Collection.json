		{
			"name": "Service Requests",
			"item": [
				{
					"name": "List Requests (Scoped by Role)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/requests?per_page=15&sort_by=created_at&sort_order=desc",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"requests"
							],
							"query": [
								{
									"key": "per_page",
									"value": "15"
								},
								{
									"key": "sort_by",
									"value": "created_at"
								},
								{
									"key": "sort_order",
									"value": "desc"
								},
								{
									"key": "search",
									"value": "Monitor",
									"disabled": true
								},
								{
									"key": "status",
									"value": "submitted",
									"disabled": true
								}
							]
						}
					}
				},
